# Grooveli Careers — frontend environment variables
#
# Only values that are safe to ship inside a browser bundle belong here.
# NEVER put AI provider keys, database credentials or auth secrets in this file:
# every Vite variable prefixed with VITE_ is inlined into the public bundle.

# Base URL of the Grooveli application API. Leave empty to keep the mock layer on.
# Against Supabase this points at the `api` Edge Function router:
#   https://<project-ref>.supabase.co/functions/v1/api
VITE_API_BASE_URL=

# Flip to "false" once the backend is reachable, to route services at the real API.
VITE_USE_MOCKS=true

# Surfaces that stay on mocks even when VITE_USE_MOCKS is "false".
#
# Going live is not all-or-nothing. The AI career centre is blocked on a
# provider, a server-side key and a budget decision rather than on engineering,
# so naming it here keeps six screens running on good mock data instead of
# showing six error states — and the surfaces that ARE live do not have to wait
# for it.
#
# Covers aiService in full, plus the skill-challenge grading in missionService,
# which needs the same model. Empty the list as each surface lands.
VITE_MOCK_SURFACES=ai

# Artificial latency (ms) applied to mock service calls so loading states stay honest.
VITE_MOCK_LATENCY=360
